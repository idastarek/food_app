generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ingredients {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  quantity String
  unit     String
}

model recipes {
  id     Int      @id @default(autoincrement())
  recipeName   String   @unique
  ingredients  Json
  instruction String[]
}
